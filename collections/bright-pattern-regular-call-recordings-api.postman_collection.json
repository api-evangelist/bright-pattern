                    }
                  ],
                  "variable": [
                    {
                      "description": "Your Bright Pattern Contact Center tenant hostname.",
                      "type": "any",
                      "value": "{{tenant_url}}",
                      "key": "tenant_url"
                    }
                  ]
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: bearer",
                      "type": "text/plain"
                    },
