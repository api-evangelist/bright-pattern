        {
          "id": "6536a3e6-5c84-47ea-a25e-bc2fd7c65226",
          "name": "Erase Call Recordings",
          "request": {
            "name": "Erase Call Recordings",
            "description": {
              "content": "This method erases locally stored call recordings; the interaction’s Global Interaction Identifier (GIID) must be included as a query parameter in the request URL\n\nNotes\n\nReason is an optional query parameter.\n\nThis method applies to locally stored recordings only.\n\nIf multiple recordings are associated with the specified GIID, all of them will be erased.\n\nThe erasure of recordings is:\nTracked via the Audit Log\n\nReflected in Interaction Records Search Results\n\nReflected in case activity history",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "configapi",
                "v2",
                "recordings",
                "audio"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "giid",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "reason",
                  "value": "<string>"
                }
              ],
              "variable": [
                {
                  "description": "Your Bright Pattern Contact Center tenant hostname.",
                  "type": "any",
                  "value": "{{tenant_url}}",
                  "key": "tenant_url"
                }
              ]
            },
            "method": "DELETE",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
          "response": [
            {
              "id": "3086fa8d-5275-42ce-8be9-75a0a3a639e8",
              "name": "Erase Call Recordings",
              "originalRequest": {
                "url": {
