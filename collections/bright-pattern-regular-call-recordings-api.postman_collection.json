  "item": [
    {
      "id": "d909efee-17d2-48a0-ab0e-3299815937c7",
      "name": "Regular Call Recordings",
      "description": {
        "content": "These methods enable retrieval of regular voice recordings (i.e., recordings where voices of all participating parties are recorded in the same audio file) and the related call metadata. Both audio files and metadata can be retrieved immediately upon call termination. Parameters required for recording identificaiton can be obtained via scenario variables $(item.globalInteractionId) and $(item.interactionStepId).\nRegular call recordings are exported in GSM format.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "45764018-dd60-4225-b694-32eea63d0317",
          "name": "Get Regular Recording Audio File",
          "request": {
            "name": "Get Regular Recording Audio File",
            "description": {
              "content": "Returns an audio file with voices of all participants for the specified call recording in the GSM format.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "configapi",
                "v2",
                "recordings",
                "audio"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "giid",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "stepid",
                  "value": "<string>"
                }
              ],
              "variable": [
                {
                  "description": "Your Bright Pattern Contact Center tenant hostname.",
                  "type": "any",
                  "value": "{{tenant_url}}",
                  "key": "tenant_url"
                }
              ]
            },
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
