        {
          "id": "59aa6c25-bd58-429d-a0b9-cb6a36782292",
          "name": "Get Interaction Metadata",
          "request": {
            "name": "Get Interaction Metadata",
            "description": {
              "content": "Returns the following metadata for the specified interaction:\n\nData Item\nDescription\n\nStart Time\nInteraction start time\n\nAgent loginId\nUsername of the agent who last handled this call\n\nAgent First Name\nFirst name of the agent who last handled this call\n\nAgent Last Name\nLast name of the agent who last handled this call\n\nCustomer phone\nCustomer’s phone number (technically, the phone number of the party opposite to the above agent)\n\nDirection\nCall direction relative to the above agent, Inbound or Outbound\n\nService\nName of the service or campaign associated with this call\n\nDisposition\nDisposition selected by the agent for this interaction\n\nNotes\nNotes entered by the agent for this interaction\n\nVoice Signature\nIndicates whether the recording contains a vocie signature.\n\nFlagged\nIndicates whether the interaction was flagged by the agent.\n\nTalk Time\nOverall call duration.\n\nRecordingId\nName of the file that contains the recording of this interaction.\n\nReview URL\nLink for direct access to the recording via the Contact Center Administrator application (login required).\n\nScreen Recording\nIndicates whether an agent screen recording is available for this interaction.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "configapi",
                "v2",
                "recordings",
                "metadata"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "giid",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "stepid",
                  "value": "<string>"
                }
              ],
              "variable": [
                {
                  "description": "Your Bright Pattern Contact Center tenant hostname.",
                  "type": "any",
                  "value": "{{tenant_url}}",
                  "key": "tenant_url"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
          "response": [
            {
              "id": "1489f9ee-7fa6-4dea-88ba-3ac77fe9f3d1",
              "name": "Metadata for a call with a live agent",
              "originalRequest": {
                "url": {
                  "path": [
                    "configapi",
                    "v2",
                    "recordings",
                    "metadata"
                  ],
                  "host": [
                    "{{baseUrl}}"
