        {
          "id": "d9bb92c9-c767-421f-97f0-e2fdbb72cf30",
          "name": "Add Records to DNC",
          "request": {
            "name": "Add Records to DNC",
            "description": {
              "content": "This method adds new records to the specified Do Not Call (DNC) list and returns the number of added (i.e., appended) records. Duplicates are ignored.\n\nAn optional comment field value is inserted in the comment field of a geographic (postal) DNC record, campaign name field of an internal DNC record, and in the comment field of area codes DNC record. This method is supported for internal, geographic postal, area codes, and record exclusion DNC lists.\n\nResponse Codes\n\nCode\nDescription\n\n200\nSuccess\n\n400\nBad request (format not understood)\n\n401\nAuthentication failed\n\n403\nUser authenticated but does not have sufficient privileges, or modification of this type of list is not allowed\n\n404\nCalling List is not found or invalid URL",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "configapi",
                "v2",
                "donotcalllist",
                "add",
                ":do_not_call_list_name"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "do_not_call_list_name",
                  "description": "(Required) "
                },
                {
                  "description": "Your Bright Pattern Contact Center tenant hostname.",
                  "type": "any",
                  "value": "{{tenant_url}}",
                  "key": "tenant_url"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
